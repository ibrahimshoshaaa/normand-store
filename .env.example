# Normand — standalone store
# Copy to .env and fill in your Neon connection string.
# Neon project: Normand — database: normand — region: Frankfurt (eu-central-1).
# Get the connection string from Neon dashboard -> project Normand -> Connection string
# (use the pooled connection, e.g. ...-pooler.eu-central-1.aws.neon.tech).
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/normand?sslmode=require"

# Admin password for /admin (set a long random value, e.g. from `openssl rand -hex 24`).
# If left empty, the admin dashboard is open to anyone and shows a warning
# banner instead — set it before going live.
ADMIN_PASSWORD="change-me-to-a-long-random-password"
